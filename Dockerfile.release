# Binaries are built on native Ubuntu 24.04 runners; match their glibc runtime.
# No RUN instructions: assembling either architecture does not require QEMU.
FROM ubuntu:24.04
ARG TARGETARCH

WORKDIR /app
COPY --chown=65534:65534 --chmod=0755 linux/${TARGETARCH}/zggsds ./zggsds
COPY --chown=65534:65534 data/ ./data/

USER 65534:65534
EXPOSE 3000
ENV RUST_LOG=info
ENTRYPOINT ["./zggsds"]
